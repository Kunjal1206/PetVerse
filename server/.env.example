# PetVerse Backend Environment Configuration

# Server Port
PORT=5000

# PostgreSQL database URI (Optional - backend uses in-memory fallback if blank or connection fails)
# E.g., postgresql://username:password@hostname:5432/databasename?sslmode=require
DATABASE_URL=

# JWT Sign secret (Keep this highly secure in production)
JWT_SECRET=petverse_production_grade_secret_key_987654321

# Google Gemini API Key (Optional - falls back to robust rule-based assistant if blank)
GEMINI_API_KEY=
